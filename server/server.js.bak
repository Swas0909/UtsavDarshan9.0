// Import reviews data
const reviews = require('./data/reviews');

// API Routes
app.get('/api/pandals', (req, res) => {
  const { search, location, theme, distance, lat, lng, sortBy } = req.query;
  let filtered = [...pandalsData];

  if (search) {
    const searchLower = search.toLowerCase();
    filtered = filtered.filter(p => 
      p.name.toLowerCase().includes(searchLower) ||
      p.location.toLowerCase().includes(searchLower) ||
      p.theme.toLowerCase().includes(searchLower)
    );
  }

  if (location) {
    filtered = filtered.filter(p => 
      p.location.toLowerCase().includes(location.toLowerCase())
    );
  }

  if (theme) {
    filtered = filtered.filter(p => 
      p.theme.toLowerCase() === theme.toLowerCase()
    );
  }

  if (distance && lat && lng) {
    const userLat = parseFloat(lat);
    const userLng = parseFloat(lng);
    const maxDistance = parseFloat(distance);

    filtered = filtered.filter(p => {
      const d = calculateDistance(
        userLat,
        userLng,
        p.coordinates.lat,
        p.coordinates.lng
      );
      return d <= maxDistance;
    });

    if (sortBy === 'distance') {
      filtered.sort((a, b) => {
        const distA = calculateDistance(userLat, userLng, a.coordinates.lat, a.coordinates.lng);
        const distB = calculateDistance(userLat, userLng, b.coordinates.lat, b.coordinates.lng);
        return distA - distB;
      });
    }
  }

  res.json(filtered);
});

// Get pandal by ID
app.get('/api/pandals/:id', (req, res) => {
  const pandal = pandalsData.find(p => p.id === parseInt(req.params.id));
  if (!pandal) {
    return res.status(404).json({ error: 'Pandal not found' });
  }
  res.json(pandal);
});

// Helper function to calculate distance between coordinates
function calculateDistance(lat1, lon1, lat2, lon2) {
  const R = 6371; // Radius of the Earth in km
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLon = (lon2 - lon1) * Math.PI / 180;
  const a = 
    Math.sin(dLat/2) * Math.sin(dLat/2) +
    Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * 
    Math.sin(dLon/2) * Math.sin(dLon/2);
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
  return R * c; // Distance in km
}

